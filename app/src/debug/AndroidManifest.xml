<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- ADB/manual firing is intentionally available only in debug artifacts. -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="com.anaalarm.action.DEBUG_FIRE_ALARM" />
            </intent-filter>
        </receiver>

        <!-- Debug-only host for createComposeRule()-based Compose UI tests. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false" />

        <!-- ADB-launched product-tour gallery used to capture docs/screenshots. -->
        <activity
            android:name=".debug.DocsGalleryActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AnaAlarm"
            android:launchMode="singleTop" />
    </application>
</manifest>
