<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service android:name=".debug.ScriptedRecognitionService" android:exported="true" tools:ignore="ForegroundServiceType"
            android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>
        <service android:name=".debug.ScriptedTtsService" android:exported="true" tools:ignore="ForegroundServiceType">
            <intent-filter><action android:name="android.intent.action.TTS_SERVICE" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <meta-data android:name="android.speech.tts" android:resource="@xml/scripted_tts_engine" />
        </service>
        <!-- ADB/manual firing is intentionally available only in debug artifacts. -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="com.anaalarm.action.DEBUG_FIRE_ALARM" />
            </intent-filter>
        </receiver>

        <!-- Debug-only host for createComposeRule()-based Compose UI tests. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false" />

        <!-- ADB-launched product-tour gallery used to capture docs/screenshots. -->
        <activity
            android:name=".debug.DocsGalleryActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AnaAlarm"
            android:launchMode="singleTop" />
    </application>
</manifest>
